---
import { site } from '../config';
---
    <!-- 4. Brand statement — pinned horizontal type -->
    <section id="statement" class="statement" aria-label="What we stand for">
      <div class="statement__pin">
        <div class="statement__top">
          <span class="kicker kicker--light">What we stand for</span>
          <span class="statement__note">Keep scrolling</span>
        </div>
        <div class="statement__orb" data-orb aria-hidden="true"></div>
        <p class="statement__track" data-st-track>Ambition into <span data-accent>direction. Direction</span> into businesses people remember.</p>
        <div class="statement__bottom"><span>{site.name} — Sydney · Melbourne · Remote</span><span>Since 2012</span></div>
      </div>
    </section>
