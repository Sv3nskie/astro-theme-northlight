---
import { site } from '../config';
---
    <!-- 2. Value proposition -->
    <section id="value" class="value" aria-label={`Why ${site.name}`}>
      <span class="kicker" data-reveal>Why {site.name}</span>
      <p class="value__statement" data-words>Most businesses don’t need more noise. They need a <span data-accent>clear direction</span> — and a partner who sees it through.</p>
      <div class="value__foot">
        <p class="lede" data-reveal>We work with founders and leadership teams at the moments that matter: entering a new market, repositioning a brand, or scaling operations without losing what made the business work in the first place.</p>
        <div data-reveal style="--d:.15s">
          <a href="#about" class="btn btn-ghost btn-lg" data-magnetic>How we work <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></a>
        </div>
      </div>
    </section>
