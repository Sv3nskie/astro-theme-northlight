---
import { site } from '../config';
---
<header class="nav" data-nav>
  <div class="nav__bar">
    <a href="#top" class="logo" aria-label={`${site.name} home`}><span class="logo__mark"></span>{site.name}</a>
    <nav class="nav__links" aria-label="Main">
      <span class="nav__svc" data-mega-trigger><a href="#services" class="nav__link">Services</a></span>
      <a href="#solutions" class="nav__link">Solutions</a>
      <a href="#about" class="nav__link">About</a>
      <a href="#work" class="nav__link">Client stories</a>
      <a href="#contact" class="nav__link">Contact</a>
    </nav>
    <a href="#contact" class="btn btn-primary btn-sm nav__cta" data-magnetic>Start a project</a>
    <button type="button" class="btn btn-ghost btn-icon nav__toggle" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="menu">
      <svg class="nav__icon nav__icon--open" width="22" height="22" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"/></svg>
      <svg class="nav__icon nav__icon--close" width="22" height="22" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg>
    </button>
  </div>
  <span class="rule nav__rule"></span>

  <!-- Services mega-menu (desktop, hover) -->
  <div class="mega" data-mega>
    <div class="mega__grid">
      <a href="#services" class="mega__item" data-svc-go="0"><span class="mega__idx tnum">01</span><span class="mega__title">Strategy</span><span class="mega__desc">Positioning, growth and commercial models.</span></a>
      <a href="#services" class="mega__item" data-svc-go="1"><span class="mega__idx tnum">02</span><span class="mega__title">Brand &amp; identity</span><span class="mega__desc">Naming, identity systems and voice.</span></a>
      <a href="#services" class="mega__item" data-svc-go="2"><span class="mega__idx tnum">03</span><span class="mega__title">Digital &amp; product</span><span class="mega__desc">Websites, platforms and customer journeys.</span></a>
      <a href="#services" class="mega__item" data-svc-go="3"><span class="mega__idx tnum">04</span><span class="mega__title">Operations</span><span class="mega__desc">Process, systems and team structure.</span></a>
    </div>
  </div>
</header>
