---
import { site } from '../config';
---
    <!-- 9. Footer -->
    <footer class="footer">
      <div class="wordmark" data-reveal="letters" aria-hidden="true">{[...site.name].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</div>
      <span class="rule footer__rule"></span>
      <div class="footer__cols">
        <div class="footer__brand">
          <span class="logo logo--static"><span class="logo__mark"></span>{site.name}</span>
          <p class="footer__tag">Strategy, brand and operations for growing companies.</p>
        </div>
        <nav class="footer__col" aria-label="Services">
          <span class="footer__h">Services</span>
          <a href="#services" data-svc-go="0">Strategy</a>
          <a href="#services" data-svc-go="1">Brand &amp; identity</a>
          <a href="#services" data-svc-go="2">Digital &amp; product</a>
          <a href="#services" data-svc-go="3">Operations</a>
        </nav>
        <nav class="footer__col" aria-label="Company">
          <span class="footer__h">Company</span>
          <a href="#about">About</a>
          <a href="#work">Client stories</a>
          <a href="#solutions">Solutions</a>
          <a href="#contact">Contact</a>
        </nav>
        <div class="footer__col footer__contact">
          <span class="footer__h">Contact</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span class="footer__text">{site.phone}</span>
          <span class="muted">{site.address}</span>
        </div>
      </div>
      <div class="footer__bottom">
        <span>© {new Date().getFullYear()} {site.legalName} · Theme by <a href="https://sv3n.dev?utm_source=astro-theme&utm_medium=referral&utm_campaign=northlight">Sv3n</a></span>
        <div class="footer__legal">
          <a href="#">LinkedIn</a>
          <a href="#">Instagram</a>
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
          <a href="#">Accessibility</a>
        </div>
      </div>
    </footer>
