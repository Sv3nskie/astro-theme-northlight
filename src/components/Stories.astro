---
import { site } from '../config';
---
    <!-- 7. Client stories — pinned horizontal track -->
    <section id="work" class="work" aria-labelledby="work-title">
      <div class="work__pin">
        <div class="work__head">
          <div>
            <span class="kicker">04 — Client stories</span>
            <h2 id="work-title" class="work__title">In their words.</h2>
          </div>
          <div class="work__controls work__controls--head">
            <span class="work__count tnum"><b data-work-index>01</b> / 03</span>
            <button type="button" class="btn btn-secondary btn-round" data-work-prev aria-label="Previous story"><svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"/></svg></button>
            <button type="button" class="btn btn-secondary btn-round" data-work-next aria-label="Next story"><svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg></button>
          </div>
        </div>

        <div class="work__viewport">
          <div class="work__track" data-work-track>
            <figure class="story">
              <img class="cover lighten" loading="lazy" decoding="async" alt=""
                src="https://images.unsplash.com/photo-1453396450673-3fe83d2db2c4?auto=format&amp;fit=crop&amp;w=1600&amp;q=70"
                srcset="https://images.unsplash.com/photo-1453396450673-3fe83d2db2c4?auto=format&amp;fit=crop&amp;w=800&amp;q=70 800w,
                        https://images.unsplash.com/photo-1453396450673-3fe83d2db2c4?auto=format&amp;fit=crop&amp;w=1200&amp;q=70 1200w,
                        https://images.unsplash.com/photo-1453396450673-3fe83d2db2c4?auto=format&amp;fit=crop&amp;w=1600&amp;q=70 1600w"
                sizes="(min-width: 720px) 64vw, 86vw">
              <div class="story__shade"></div>
              <figcaption class="story__cap">
                <blockquote class="story__quote">“{site.name} gave us the clarity to make a decision we’d been circling for two years. Six months later we’re in three new markets.”</blockquote>
                <div class="story__meta">
                  <span class="story__who"><span class="story__name">Alex Morgan</span><span class="story__role">CEO, Harbour Goods</span></span>
                  <span class="tag tag-accent">Strategy · Launch</span>
                </div>
              </figcaption>
            </figure>

            <figure class="story">
              <img class="cover lighten" loading="lazy" decoding="async" alt=""
                src="https://images.unsplash.com/photo-1516117525866-d85459db7457?auto=format&amp;fit=crop&amp;w=1600&amp;q=70"
                srcset="https://images.unsplash.com/photo-1516117525866-d85459db7457?auto=format&amp;fit=crop&amp;w=800&amp;q=70 800w,
                        https://images.unsplash.com/photo-1516117525866-d85459db7457?auto=format&amp;fit=crop&amp;w=1200&amp;q=70 1200w,
                        https://images.unsplash.com/photo-1516117525866-d85459db7457?auto=format&amp;fit=crop&amp;w=1600&amp;q=70 1600w"
                sizes="(min-width: 720px) 64vw, 86vw">
              <div class="story__shade"></div>
              <figcaption class="story__cap">
                <blockquote class="story__quote">“The new brand finally looks like the company we’ve become. Enquiries doubled in the first quarter after launch.”</blockquote>
                <div class="story__meta">
                  <span class="story__who"><span class="story__name">Priya Shah</span><span class="story__role">Founder, Lumen Health</span></span>
                  <span class="tag tag-accent">Brand · Digital</span>
                </div>
              </figcaption>
            </figure>

            <figure class="story">
              <img class="cover lighten" loading="lazy" decoding="async" alt=""
                src="https://images.unsplash.com/photo-1544502062-f82887f03d1c?auto=format&amp;fit=crop&amp;w=1600&amp;q=70"
                srcset="https://images.unsplash.com/photo-1544502062-f82887f03d1c?auto=format&amp;fit=crop&amp;w=800&amp;q=70 800w,
                        https://images.unsplash.com/photo-1544502062-f82887f03d1c?auto=format&amp;fit=crop&amp;w=1200&amp;q=70 1200w,
                        https://images.unsplash.com/photo-1544502062-f82887f03d1c?auto=format&amp;fit=crop&amp;w=1600&amp;q=70 1600w"
                sizes="(min-width: 720px) 64vw, 86vw">
              <div class="story__shade"></div>
              <figcaption class="story__cap">
                <blockquote class="story__quote">“They didn’t hand us a deck and leave. They rebuilt how we operate, alongside our team, and stayed until it stuck.”</blockquote>
                <div class="story__meta">
                  <span class="story__who"><span class="story__name">Tom Reilly</span><span class="story__role">COO, Northgate Logistics</span></span>
                  <span class="tag tag-accent">Operations · Scale</span>
                </div>
              </figcaption>
            </figure>
          </div>
        </div>

        <div class="work__foot">
          <span class="work__line"><span class="work__line-fill" data-work-line></span></span>
          <div class="work__controls work__controls--foot">
            <span class="work__count tnum"><b data-work-index>01</b> / 03</span>
            <button type="button" class="btn btn-secondary btn-round" data-work-prev aria-label="Previous story"><svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"/></svg></button>
            <button type="button" class="btn btn-secondary btn-round" data-work-next aria-label="Next story"><svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg></button>
          </div>
        </div>
      </div>
    </section>
