---
import { site } from '../config';
---
    <!-- 6. About / credibility -->
    <section id="about" class="about" aria-labelledby="about-title">
      <div class="about__grid">
        <div class="about__copy">
          <span class="kicker" data-reveal>03 — About {site.name}</span>
          <h2 id="about-title" class="about__title" data-reveal style="--d:.08s">Four disciplines. One senior team.</h2>
          <p class="lede about__lede" data-reveal style="--d:.16s">Founded in 2012, {site.name} brings strategists, designers and operators together in small, senior teams. No hand-offs to juniors, no templated playbooks — just the people you met, doing the work.</p>
          <div class="stats">
            <div class="stat" data-reveal style="--d:.2s">
              <p class="stat__num tnum" data-count="14">14</p>
              <p class="stat__label">Years in practice</p>
            </div>
            <div class="stat" data-reveal style="--d:.28s">
              <p class="stat__num tnum" data-count="180" data-suffix="+">180+</p>
              <p class="stat__label">Engagements delivered</p>
            </div>
            <div class="stat" data-reveal style="--d:.36s">
              <p class="stat__num tnum" data-count="92" data-suffix="%">92%</p>
              <p class="stat__label">Clients who return</p>
            </div>
          </div>
        </div>

        <div class="stage-wrap" data-stage-wrap role="img" aria-label="Four stacked layers: Strategy, Brand and identity, Digital and product, Operations">
          <div class="stage" data-stage aria-hidden="true">
            <div class="plate" data-plate style="--z:-54px">
              <span class="plate__top"><span>04</span><span>Operations</span></span>
              <span class="plate__line" style="width:36%"></span>
            </div>
            <div class="plate" data-plate style="--z:-18px">
              <span class="plate__top"><span>03</span><span>Digital &amp; product</span></span>
              <span class="plate__line" style="width:52%"></span>
            </div>
            <div class="plate" data-plate style="--z:18px">
              <span class="plate__top"><span>02</span><span>Brand &amp; identity</span></span>
              <span class="plate__line" style="width:68%"></span>
            </div>
            <div class="plate plate--front" data-plate style="--z:54px">
              <span class="plate__top"><span>01</span><span>Strategy</span></span>
              <span class="plate__foot"><span class="plate__title">One team, four layers.</span><span class="plate__line" style="width:84%"></span></span>
            </div>
          </div>
          <span class="stage-wrap__caption" aria-hidden="true"><span class="caption--hover">Scroll and hover to explore</span><span class="caption--touch">Scroll and tap to explore</span></span>
        </div>
      </div>
    </section>
