---
import { site } from '../config';
---
    <!-- 8. Final CTA -->
    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="contact__glow" data-glow aria-hidden="true"></div>
      <div class="contact__inner">
        <div class="contact__grid">
          <div>
            <h2 id="contact-title" class="contact__title" data-reveal="scale"><span>Let’s talk about</span><span class="accent">what’s next.</span></h2>
            <p class="contact__lede" data-reveal style="--d:.12s">Tell us where you’re headed. A partner will reply within one business day to set up a no-obligation conversation.</p>
            <div class="contact__lines" data-reveal style="--d:.2s">
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <span class="muted">{site.phone}</span>
            </div>
          </div>

          <div class="card contact__card" data-reveal style="--d:.15s">
            <!-- Set data-endpoint to a form service URL (e.g. Formspree) to deliver enquiries. -->
            <form class="form" data-form data-endpoint="">
              <div class="form__row">
                <label class="field"><span class="field__label">Name</span><input class="input" name="name" required autocomplete="name"></label>
                <label class="field"><span class="field__label">Email</span><input class="input" type="email" name="email" required autocomplete="email"></label>
              </div>
              <label class="field"><span class="field__label">Company</span><input class="input" name="company" autocomplete="organization"></label>
              <label class="field"><span class="field__label">What are you working on?</span><textarea class="input" name="message" rows="4"></textarea></label>
              <button type="submit" class="btn btn-primary btn-lg form__submit" data-magnetic>Send enquiry</button>
            </form>
            <div class="success" data-success role="status" tabindex="-1" hidden>
              <span class="success__icon"><svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z"/></svg></span>
              <h3 class="success__title">Thanks — we’ll be in touch.</h3>
              <p class="success__text">A partner will reply within one business day.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
