---
import { site } from '../config';
---
    <section class="cred" aria-label="Clients">
      <div class="container"><span class="rule"></span></div>
      <div class="cred__head">
        <span class="kicker" data-reveal>Trusted by leadership teams at</span>
        <span class="cred__note" data-reveal style="--d:.08s">180+ engagements across Australia and APAC</span>
      </div>
      <div class="marquee" data-marquee-wrap>
        <div class="marquee__track" data-marquee>
          <div class="marquee__group" data-marquee-group>
            <span>Harbour Goods</span><span>Lumen Health</span><span>Northgate Logistics</span><span>Aster &amp; Vale</span><span>Fieldstone Capital</span><span>Kestrel Energy</span><span>Marlow Studio</span><span>Orbit Freight</span>
          </div>
          <div class="marquee__group" aria-hidden="true">
            <span>Harbour Goods</span><span>Lumen Health</span><span>Northgate Logistics</span><span>Aster &amp; Vale</span><span>Fieldstone Capital</span><span>Kestrel Energy</span><span>Marlow Studio</span><span>Orbit Freight</span>
          </div>
        </div>
      </div>
    </section>
