---
import { site } from '../config';
---
  <!-- 1. Hero -->
  <section id="hero" class="hero" aria-label="Introduction">
    <div class="hero__zoom">
      <div class="hero__scroll" data-hero-scroll>
        <img class="cover lighten hero__img"
          src="https://images.unsplash.com/photo-1703696381789-3ef203ddf609?auto=format&amp;fit=crop&amp;w=2400&amp;q=75"
          srcset="https://images.unsplash.com/photo-1703696381789-3ef203ddf609?auto=format&amp;fit=crop&amp;w=800&amp;q=75 800w,
                  https://images.unsplash.com/photo-1703696381789-3ef203ddf609?auto=format&amp;fit=crop&amp;w=1200&amp;q=75 1200w,
                  https://images.unsplash.com/photo-1703696381789-3ef203ddf609?auto=format&amp;fit=crop&amp;w=1800&amp;q=75 1800w,
                  https://images.unsplash.com/photo-1703696381789-3ef203ddf609?auto=format&amp;fit=crop&amp;w=2400&amp;q=75 2400w"
          sizes="100vw" alt="" fetchpriority="high" decoding="async">
        <div class="hero__shade"></div>
      </div>
    </div>

    <div class="hero__copy" data-hero-copy>
      <h1 class="hero__title">
        <span class="mask"><span class="hero__line" data-line style="--d:0s">Clarity for</span></span>
        <span class="mask"><span class="hero__line" data-line style="--d:.09s">businesses</span></span>
        <span class="mask"><span class="hero__line hero__line--muted" data-line style="--d:.18s">built to last.</span></span>
      </h1>
      <p class="hero__lede" data-line style="--d:.27s">{site.name} is an independent advisory partner for growing companies — strategy, brand and operations under one roof, led by senior people from first call to launch.</p>
      <div class="hero__ctas" data-line style="--d:.36s">
        <a href="#contact" class="btn btn-primary btn-lg" data-magnetic>Start a project <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></a>
        <a href="#services" class="btn btn-ghost btn-lg">Explore services</a>
      </div>
    </div>

    <div class="hero__hint" aria-hidden="true">
      <span>Scroll</span>
      <span class="hero__track"><span class="hero__sweep"></span></span>
    </div>
  </section>
