---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Hero from '../components/Hero.astro';
import Value from '../components/Value.astro';
import Services from '../components/Services.astro';
import Statement from '../components/Statement.astro';
import Solutions from '../components/Solutions.astro';
import About from '../components/About.astro';
import Clients from '../components/Clients.astro';
import Stories from '../components/Stories.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <a class="skip-link" href="#value">Skip to content</a>
  <div class="vh-probe" aria-hidden="true"></div>
  <Intro />
  <div class="cursor" aria-hidden="true"></div>
  <Header />
  <MobileMenu />
  <main id="top" class="page">
    <Hero />
    <!-- Everything below slides up over the pinned hero -->
    <div id="sheet" class="sheet">
      <Value />
      <Services />
      <Statement />
      <Solutions />
      <About />
      <Clients />
      <Stories />
      <Contact />
      <Footer />
    </div>
  </main>
  <!-- Placeholder photography: Unsplash (John Murphey, Bruno BD, Vitor Paladini, Sergio Franklin,
       Vitaly Gariev, Martin Laprise, Joshua Fernandez, Maxim, Drew, Richard Jaimes, Joe Shields). -->
</Base>
